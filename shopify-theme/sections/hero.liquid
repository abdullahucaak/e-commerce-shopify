{%- liquid
  assign hero_image = section.settings.image
  assign hero_title = section.settings.heading
  assign hero_copy = section.settings.copy

  if settings.use_cms_branding
    if shop.metafields.store_builder.hero_image.value != blank
      assign hero_image = shop.metafields.store_builder.hero_image.value
    endif
    if shop.metafields.store_builder.hero_title.value != blank
      assign hero_title = shop.metafields.store_builder.hero_title.value
    endif
    if shop.metafields.store_builder.hero_copy.value != blank
      assign hero_copy = shop.metafields.store_builder.hero_copy.value
    endif
  endif
-%}

<section class="hero{% if hero_image == blank %} hero--placeholder{% endif %}">
  {%- if hero_image != blank -%}
    {{
      hero_image
      | image_url: width: 2400
      | image_tag:
        class: 'hero__image',
        widths: '640, 960, 1280, 1600, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
    }}
  {%- endif -%}
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content page-width">
    <div class="hero__message">
      {%- if hero_title != blank -%}<h1>{{ hero_title | escape }}</h1>{%- endif -%}
      {%- if hero_copy != blank -%}<div class="hero__copy rte">{{ hero_copy | escape | newline_to_br }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet our newest collection"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Description",
      "default": "A thoughtful collection, selected for quality and made to be enjoyed."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
