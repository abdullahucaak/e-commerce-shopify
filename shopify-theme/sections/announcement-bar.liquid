{%- if section.settings.text != blank -%}
  <aside class="announcement" aria-label="Announcement">
    {%- if section.settings.link != blank -%}
      <a class="announcement__link" href="{{ section.settings.link }}">
        {{ section.settings.text | escape }}
      </a>
    {%- else -%}
      <p>{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Until October 20th, enjoy a 10% discount on every product with the code '1A18NM'!"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
