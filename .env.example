# Existing single-store fallback (local development only)
VITE_SHOPIFY_DOMAIN=your-development-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=public-storefront-token
VITE_SHOPIFY_API_VERSION=2026-07
VITE_SHOPIFY_COUNTRY_CODE=US
VITE_STOREFRONT_NAME=GlowField

# Multi-store runtime. In local development this hostname selects the tenant.
VITE_API_URL=
VITE_STOREFRONT_HOST=glowfield.co
VITE_YOURPROSTORE_AI_ADMIN_URL=http://127.0.0.1:5176/

# Supabase Auth (both values are public browser configuration, not secret keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Backend-only; required before processing shop/redact when a shop owns Storage files.
SUPABASE_SERVICE_ROLE_KEY=

# Backend (Supabase PostgreSQL connection string; never expose it with a VITE_ prefix)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
DATABASE_SSL=true
API_HOST=127.0.0.1
PORT=3000
# General JSON request body limit and per-IP rate limit. Asset uploads keep their
# separate 8 MiB file limit; multi-instance production should use a shared limiter store.
API_BODY_LIMIT_BYTES=1048576
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
# Only during secret rotation; remove immediately after revoking the old secret.
SHOPIFY_PREVIOUS_CLIENT_SECRET=
# Development uses Shopify CLI's HTTPS localhost proxy; production uses the deployed API URL.
SHOPIFY_APP_URL=https://127.0.0.1:3458
# Shopify Dev/Partner Dashboard distribution link. It lets Shopify handle
# account login and store selection before returning to /api/shopify/install.
SHOPIFY_INSTALL_URL=
YOURPROSTORE_AI_APP_URL=http://127.0.0.1:5175
STOREFRONT_ADMIN_APP_URL=http://127.0.0.1:5174
# Separate production secret used to encrypt short-lived customer SSO sessions.
AUTH_HANDOFF_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Separate HMAC key for five-minute storefront draft preview links.
STOREFRONT_PREVIEW_SIGNING_KEY=replace-with-another-long-random-secret
# Billing provider: use mock only in development/test. Production rejects mock.
BILLING_PROVIDER=mock
# Stripe Billing. When BILLING_PROVIDER=stripe, create a recurring USD 9/month
# Price and configure all three values below.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_STARTER_MONTHLY_PRICE_ID=price_your-usd-9-monthly-price
VITE_STOREFRONT_PREVIEW_URL=http://127.0.0.1:5173/
VITE_STOREFRONT_ADMIN_URL=http://127.0.0.1:5174/
VITE_YOURPROSTORE_AI_URL=http://127.0.0.1:5175/
ALLOW_STOREFRONT_HOST_OVERRIDE=true
TRUST_PROXY=false
