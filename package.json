{
  "name": "yourprostore-ai-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:storefront",
    "dev:storefront": "npm run dev --workspace @yourprostore/storefront",
    "dev:storefront-admin": "npm run dev --workspace @yourprostore/storefront-admin",
    "dev:yourprostore-ai": "npm run dev --workspace @yourprostore/yourprostore-ai",
    "dev:yourprostore-ai-admin": "npm run dev --workspace @yourprostore/yourprostore-ai-admin",
    "dev:api": "npm run dev --workspace @yourprostore/api",
    "shopify:dev": "shopify app dev --use-localhost --localhost-port 3458 --no-update",
    "build": "npm run build:storefront && npm run build:storefront-admin && npm run build:yourprostore-ai && npm run build:yourprostore-ai-admin",
    "build:storefront": "npm run build --workspace @yourprostore/storefront",
    "build:storefront-admin": "npm run build --workspace @yourprostore/storefront-admin",
    "build:yourprostore-ai": "npm run build --workspace @yourprostore/yourprostore-ai",
    "build:yourprostore-ai-admin": "npm run build --workspace @yourprostore/yourprostore-ai-admin",
    "test": "npm run test:api && npm run test:storefront && npm run test:storefront-admin && npm run test:yourprostore-ai && npm run test:yourprostore-ai-admin && npm run test:theme",
    "test:api": "npm run test --workspace @yourprostore/api",
    "test:storefront": "npm run test --workspace @yourprostore/storefront",
    "test:storefront-admin": "npm run test --workspace @yourprostore/storefront-admin",
    "test:yourprostore-ai": "npm run test --workspace @yourprostore/yourprostore-ai",
    "test:yourprostore-ai-admin": "npm run test --workspace @yourprostore/yourprostore-ai-admin",
    "test:theme": "node scripts/validate-shopify-theme.mjs",
    "validate:deploy-env": "node scripts/validate-deployment-env.mjs",
    "db:migrate:oauth": "npm run db:migrate:oauth --workspace @yourprostore/api",
    "db:migrate:storage": "npm run db:migrate:storage --workspace @yourprostore/api",
    "db:migrate:store-selection": "npm run db:migrate:store-selection --workspace @yourprostore/api",
    "db:migrate:stripe-billing": "npm run db:migrate:stripe-billing --workspace @yourprostore/api",
    "db:migrate:shopify-app-pricing": "npm run db:migrate:shopify-app-pricing --workspace @yourprostore/api",
    "db:migrate:banner-catalog": "npm run db:migrate:banner-catalog --workspace @yourprostore/api",
    "db:migrate:auth-handoff": "npm run db:migrate:auth-handoff --workspace @yourprostore/api",
    "db:migrate:cms-roles": "npm run db:migrate:cms-roles --workspace @yourprostore/api",
    "db:migrate:asset-validation": "npm run db:migrate:asset-validation --workspace @yourprostore/api",
    "db:migrate:asset-read-isolation": "npm run db:migrate:asset-read-isolation --workspace @yourprostore/api",
    "db:migrate:shopify-webhook-resilience": "npm run db:migrate:shopify-webhook-resilience --workspace @yourprostore/api",
    "db:migrate:platform-admin-foundation": "npm run db:migrate:platform-admin-foundation --workspace @yourprostore/api",
    "db:provision:platform-admin": "npm run db:provision:platform-admin --workspace @yourprostore/api --",
    "db:seed:glowfield": "npm run db:seed:glowfield --workspace @yourprostore/api",
    "db:claim:glowfield-owner": "npm run db:claim:glowfield-owner --workspace @yourprostore/api",
    "db:verify-tenant-rls": "npm run db:verify-tenant-rls --workspace @yourprostore/api --"
  },
  "devDependencies": {
    "@shopify/cli": "^4.6.1"
  }
}
