{
  "name": "glowfield-commerce-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:storefront",
    "dev:storefront": "npm run dev --workspace @glowfield/storefront",
    "dev:platform": "npm run dev --workspace @glowfield/platform",
    "dev:customer-platform": "npm run dev --workspace @glowfield/customer-platform",
    "dev:api": "npm run dev --workspace @glowfield/api",
    "shopify:dev": "shopify app dev --use-localhost --localhost-port 3458 --no-update",
    "build": "npm run build:storefront && npm run build:platform && npm run build:customer-platform",
    "build:storefront": "npm run build --workspace @glowfield/storefront",
    "build:platform": "npm run build --workspace @glowfield/platform",
    "build:customer-platform": "npm run build --workspace @glowfield/customer-platform",
    "test": "npm run test:api",
    "test:api": "npm run test --workspace @glowfield/api",
    "test:storefront": "npm run test --workspace @glowfield/storefront",
    "test:platform": "npm run test --workspace @glowfield/platform",
    "test:theme": "node scripts/validate-shopify-theme.mjs",
    "db:migrate:oauth": "npm run db:migrate:oauth --workspace @glowfield/api",
    "db:migrate:storage": "npm run db:migrate:storage --workspace @glowfield/api",
    "db:migrate:store-selection": "npm run db:migrate:store-selection --workspace @glowfield/api",
    "db:seed:glowfield": "npm run db:seed:glowfield --workspace @glowfield/api",
    "db:claim:glowfield-owner": "npm run db:claim:glowfield-owner --workspace @glowfield/api"
  },
  "devDependencies": {
    "@shopify/cli": "^4.6.1"
  }
}
